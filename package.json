{
  "name": "pg-commit-cut-proxy",
  "version": "0.1.0",
  "description": "Deterministic wire-protocol TCP proxy for testing PostgreSQL ambiguous commits and network partition recovery",
  "keywords": [
    "postgres",
    "postgresql",
    "proxy",
    "fault-injection",
    "testing",
    "ambiguous-commit",
    "two-phase-commit",
    "wire-protocol"
  ],
  "author": "Kris Leigh Miller",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krisleighmiller/pg-commit-cut-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/krisleighmiller/pg-commit-cut-proxy/issues"
  },
  "homepage": "https://github.com/krisleighmiller/pg-commit-cut-proxy#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
